+  map: ActMap,
+  completedNodeIds: readonly string[],
+): readonly string[] {
+  if (completedNodeIds.length === 0) return [...map.starts];
+  const byId = new Map<string, MapNode>([
+    ...map.columns.flat().map((candidate) => [candidate.id, candidate] as const),
