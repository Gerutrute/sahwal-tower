+  ]);
+  const lastCompletedId = completedNodeIds.at(-1)!;
+  const lastCompleted = byId.get(lastCompletedId);
+  if (lastCompleted === undefined) throw new Error(`map references missing node: ${lastCompletedId}`);
+  return [...lastCompleted.next];
+}
